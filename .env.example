APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_BIND_IP=127.0.0.1
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_TOKEN=
# Alias admitidos por config/services.php (Sección 4 del documento)
# EARTHDATA_USER=
# EARTHDATA_PASS=
# EARTHDATA_TOKEN=

# AppEEARS (SMAP vía point sample CSV)
APPEARS_BASE_URL=https://appeears.earthdatacloud.nasa.gov/api
APPEARS_SMAP_PRODUCT=SPL3SMP_E.006
APPEARS_SMAP_LAYER=soil_moisture_am
APPEARS_SMAP_SHORT_NAME=SPL3SMP_E
APPEARS_SMAP_VERSION=061
APPEARS_TIMEOUT=1800
APPEARS_POLL=20

# GPM IMERG (vía CMR)
GPM_SHORT_NAME=GPM_3IMERGDF
GPM_VERSION=07
GPM_PAGE_SIZE=40
# Ollama en Docker (servidor casero por Tailscale)
OLLAMA_HOST=http://100.107.189.14:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=600
OLLAMA_NUM_PREDICT=200

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=120
# gemini usa la API de Google; ollama usa el servidor local por Tailscale.
LLM_DRIVER=gemini
